# LifeOS Environment Configuration

# Database
# For local SQLite development (zero-config, runs out of the box):
DATABASE_URL="file:./dev.db"

# For Supabase / PostgreSQL (Production):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Authentication & Session Security
JWT_SECRET="lifeos_super_secret_jwt_encryption_key_change_in_production_32chars"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Integration (Opsional - LifeOS memiliki sistem rekomendasi berbasis aturan otomatis tanpa API key)
AI_PROVIDER="gemini" # or "openai"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# Admin Configuration
ADMIN_EMAIL="admin@lifeos.id"

